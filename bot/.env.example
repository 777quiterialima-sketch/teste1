# ─── Instagram / Meta ──────────────────────────────────────────────────────
# Token gerado no Meta Developer Portal → App → Instagram → Generate Token
PAGE_ACCESS_TOKEN=

# Token livre que você escolhe (qualquer string) — deve ser igual no portal
VERIFY_TOKEN=meu_token_secreto_123

# ID numérico da sua conta Instagram (ex: 17841400000000000)
# Veja em: Meta Developer → Instagram → Instagram Account ID
INSTAGRAM_ACCOUNT_ID=

# ─── Suas finanças ─────────────────────────────────────────────────────────
RENDA_MENSAL=3000
META_ECONOMIA_PCT=20

# ─── Banco de dados ────────────────────────────────────────────────────────
DATABASE_PATH=financas.db
